      "description": "Strictest project tier for organs whose extensive injury can threaten life or cause major irreversible neurological or sensory loss. Includes all mapped descendants. Vital is the stable machine identifier; the full meaning is vital or critical function."
    },
    "protected": {
      "maximum_rna": 5.0,
      "roots": [
        "adipose_tissue",
        "thyroid_gland",
        "parathyroid_gland",
        "lymph_node",
        "esophagus",
        "stomach",
        "colon",
        "rectum",
        "urinary_bladder",
        "ureter",
        "cartilage",
        "oral_mucosa",
        "nasopharynx",
        "tongue"
      ],
      "description": "Protected normal tissues outside the permitted scope, with a higher RNA ceiling but the same exclusion for any positive IHC. This tier includes distributed lymph nodes and functionally important organs without a project allowance. It does not assert that extensive injury cannot be fatal."
    },
    "context_reviews": {
      "removable_digestive_organs": {
        "roots": [
          "appendix",
          "gallbladder"
        ],
        "flags": [
          "in_situ_inflammation_review"
        ],
        "references": [
          "nhs_appendix",
          "niddk_gallbladder"
        ],
        "rationale": "Organ removal can be tolerated, but in-situ immune injury may cause inflammation, leakage or obstruction. The allowance does not extend to adjacent intestine, liver, bile ducts or shared immune populations.",
        "allowance_basis": "organ_removal",
        "local_steroid_control": "not_established"
      },
      "skin_injury_extent": {
        "roots": [
          "skin"
        ],
        "flags": [
          "skin_compartment_and_extent_review",
          "local_control_not_guaranteed"
        ],
        "references": [
          "sitc2021",
          "johnson2009",
          "bradley2020"
        ],
        "rationale": "Existing whole-skin research allowance concerns potentially manageable injury, not complete barrier destruction. Distinguish pigment or follicular loss from extensive epithelial, blistering or mucosal injury. Local corticosteroid use for selected toxicities is not guaranteed rescue from persistent antigen-directed T cells.",
        "allowance_basis": "conditional_partial_injury",
        "local_steroid_control": "supported_for_selected_manifestations_not_general_ablation"
      },
      "salivary_function": {
        "roots": [
          "salivary_gland"
        ],
        "flags": [
          "persistent_salivary_dysfunction_review",
          "local_control_not_established"
        ],
        "references": [
          "warner2019",
          "bradley2020"
        ],
        "rationale": "Retains the earlier requested research allowance pending policy revision. Published immune-mediated injury can cause persistent low salivary secretion despite symptom improvement. Minor-gland expression does not establish restriction to one removable gland.",
        "allowance_basis": "explicit_project_exception",
        "local_steroid_control": "not_established_with_persistent_dysfunction_reported"
      },
      "lymphoid_organ_allowance": {
        "roots": [
          "tonsil",
          "spleen",
          "thymus"
        ],
        "flags": [
          "immune_cell_distribution_review",
          "age_and_immune_reserve_review"
        ],
        "references": [
          "nhs_tonsillectomy",
          "cdc_asplenia",
          "nci_lymph_nodes",
          "project_policy"
        ],
        "rationale": "Conditional organ allowance only. Identify the expressing cell population and its distribution in blood, marrow and other organs. Assess age and immune reserve. Surgery is not a model of systemic antigen-directed injury. Bulk tissue cannot establish organ confinement.",
        "allowance_basis": "explicit_project_exception",
        "local_steroid_control": "not_established"
      },
      "spleen_infection_risk": {
        "roots": [
          "spleen"
        ],
        "flags": [
          "asplenia_infection_risk_review"
        ],
        "references": [
          "cdc_asplenia"
        ],
        "rationale": "Assess consequences of functional asplenia and an appropriate infection-prevention and management strategy before therapeutic acceptance."
      },
      "distributed_lymph_nodes": {
        "roots": [
          "lymph_node"
        ],
        "flags": [
          "lymphatic_and_immune_function_review"
        ],
        "references": [
          "nci_lymph_nodes"
        ],
        "rationale": "Remains protected. Regional removal does not justify whole-system depletion or injury to lymphatic stroma. Lineage-specific exceptions require a separately defined policy and evidence."
      }
    },
    "unresolved_roots": [
      "head",
