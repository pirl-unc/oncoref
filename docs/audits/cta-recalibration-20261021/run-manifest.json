      "High",
      "Ascending",
      "Descending"
    ],
    "vital": {
      "maximum_rna": 1.0,
      "minimum_reproductive_selectivity": 0.75,
      "roots": [
        "heart",
        "lung",
        "bronchus",
        "brain",
        "spinal_cord",
        "liver",
        "kidney",
        "bone_marrow",
        "blood",
        "adrenal_gland",
        "pituitary_gland",
        "pancreas",
        "small_intestine",
        "skeletal_muscle",
        "smooth_muscle",
        "peripheral_nerve",
        "endothelium",
        "retina",
        "eye",
        "inner_ear"
      ],
      "description": "Strictest project tier for organs whose extensive injury can threaten life or cause major irreversible neurological or sensory loss. Includes all mapped descendants. Vital is the stable machine identifier; the full meaning is vital or critical function."
    },
    "protected": {
      "maximum_rna": 3.0,
      "minimum_reproductive_selectivity": 0.7,
      "roots": [
        "salivary_gland",
        "parathyroid_gland",
        "lymph_node",
        "esophagus",
        "stomach",
        "colon",
        "rectum",
        "urinary_bladder",
        "ureter",
        "cartilage",
        "oral_mucosa",
        "nasopharynx",
        "tongue"
      ],
      "description": "Higher protection priority for persistent functional or structural injury and important mucosal or distributed-organ function. Any positive IHC excludes. Injury can be severe or fatal; this is a relative research priority."
    },
    "manageable": {
      "maximum_rna": 5.0,
      "minimum_reproductive_selectivity": 0.65,
      "roots": [
        "skin",
        "spleen",
        "thymus",
        "thyroid_gland",
        "adipose_tissue"
      ],
      "description": "Conditional manageability is a relative project priority, informed by published caution/non-essential groups and organ-specific evidence. These tissues remain screened and any positive IHC excludes. The name describes potential management or compensation for selected injuries, not established control of every injury. It does not imply reversibility, local-steroid control or dispensability. Explicit permitted cutaneous compartments take precedence over skin."
    },
    "context_reviews": {
      "removable_digestive_organs": {
        "roots": [
          "appendix",
          "gallbladder"
        ],
        "flags": [
          "in_situ_inflammation_review"
        ],
        "references": [
          "nhs_appendix",
          "niddk_gallbladder"
        ],
        "rationale": "Organ removal can be tolerated, but in-situ immune injury may cause inflammation, leakage or obstruction. The allowance does not extend to adjacent intestine, liver, bile ducts or shared immune populations.",
        "allowance_basis": "organ_removal",
        "local_steroid_control": "not_established"
      },
      "skin_injury_extent": {
        "roots": [
          "skin"
        ],
        "flags": [
          "skin_compartment_and_extent_review",
          "local_control_not_guaranteed"
        ],
        "references": [
          "sitc2021",
          "johnson2009",
          "bradley2020"
        ],
        "rationale": "Whole skin is Manageable and remains subject to RNA and IHC gates. Distinguish permitted cutaneous pigment or follicular loss from extensive epithelial, blistering or mucosal injury. Local corticosteroid use for selected toxicities is not guaranteed rescue from persistent antigen-directed T cells.",
        "allowance_basis": "no_whole_skin_allowance",
        "local_steroid_control": "supported_for_selected_manifestations_not_general_ablation"
      },
      "salivary_function": {
        "roots": [
          "salivary_gland"
        ],
        "flags": [
          "persistent_salivary_dysfunction_review",
          "local_control_not_established"
        ],
        "references": [
          "warner2019",
          "bradley2020"
        ],
        "rationale": "Salivary glands are Protected. Published immune-mediated injury can cause persistent low salivary secretion despite symptom improvement. Minor-gland expression does not establish restriction to one removable gland.",
        "allowance_basis": "no_default_allowance",
        "local_steroid_control": "not_established_with_persistent_dysfunction_reported"
      },
      "lymphoid_organ_review": {
        "roots": [
          "tonsil",
          "spleen",
          "thymus"
        ],
        "flags": [
          "immune_cell_distribution_review",
          "age_and_immune_reserve_review"
        ],
        "references": [
          "nhs_tonsillectomy",
          "cdc_asplenia",
          "nci_lymph_nodes",
          "project_policy"
        ],
        "rationale": "Only tonsil retains a conditional allowance; spleen and thymus are Manageable and must pass RNA and IHC gates. Identify the expressing cell population and its distribution in blood, marrow and other organs. Assess age and immune reserve. Surgery is not a model of systemic antigen-directed injury. Bulk tissue cannot establish organ confinement.",
        "allowance_basis": "tonsil_only_conditional_allowance",
        "local_steroid_control": "not_established"
      },
      "spleen_infection_risk": {
        "roots": [
          "spleen"
        ],
        "flags": [
          "asplenia_infection_risk_review"
        ],
        "references": [
          "cdc_asplenia",
          "kristinsson2014"
        ],
        "rationale": "Assess consequences of functional asplenia and an appropriate infection-prevention and management strategy before therapeutic acceptance.",
        "local_steroid_control": "not_established"
      },
      "thymus_long_term_function": {
        "roots": [
          "thymus"
        ],
        "flags": [
          "thymic_function_review",
          "age_and_immune_reserve_review"
        ],
        "references": [
          "kooshesh2023"
        ],
        "rationale": "Adult thymectomy has observational associations with mortality and cancer. Thymus is Manageable, not disposable; pediatric consequences need separate review. Surgery does not quantify antigen-directed injury.",
        "local_steroid_control": "not_established"
      },
      "cartilage_structural_function": {
        "roots": [
          "cartilage"
        ],
        "flags": [
          "persistent_structural_injury_review",
          "cartilage_site_review"
        ],
        "references": [
          "heinemeier2016",
          "braaten2020"
        ],
        "rationale": "Cartilage is Protected because structural injury may persist. Articular-collagen turnover and inflammatory-arthritis studies provide indirect support, not direct chondrocyte-targeting safety evidence. A generic cartilage label does not locate a joint or exclude airway cartilage.",
        "local_steroid_control": "symptom_control_does_not_establish_structural_repair"
      },
      "distributed_lymph_nodes": {
        "roots": [
          "lymph_node"
        ],
        "flags": [
          "lymphatic_and_immune_function_review"
        ],
        "references": [
          "nci_lymph_nodes"
        ],
        "rationale": "Remains Protected. Regional removal does not justify whole-system depletion or injury to lymphatic stroma. Lineage-specific exceptions require a separately defined policy and evidence."
      }
    },
