{
  "report_schema": "oncoref.cta-recalibration-report.v1",
  "policy": {
    "policy_id": "oncoref.cta-ihc-adaptive-screen.2026-10-21.1",
    "permitted_scope": "reproductive_or_permitted_normal",
    "required_positive_scope": "reproductive",
    "minimum_reproductive_rna": 0.0,
    "reproductive_rna_comparison": "greater_than",
    "tier_labels": {
      "permitted": "Permitted",
      "vital": "Vital",
      "protected": "Protected",
      "manageable": "Manageable",
      "unresolved": "Unresolved"
    },
