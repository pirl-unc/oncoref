{
  "schema": "oncoref.curation-build.v1",
  "reference_inputs": {
    "hpa_tissue_samples": {
      "source": "hpa_individual_tissue_tpm",
      "version": "v23"
    },
    "petropoulos_tpm": {
      "source": "petropoulos_embryonic_tpm",
      "version": "E-MTAB-3929-20261028"
    },
    "petropoulos_design": {
      "source": "petropoulos_embryonic_design",
      "version": "E-MTAB-3929-20261028"
    },
    "tyser_tpm": {
      "source": "tyser_embryonic_tpm",
      "version": "E-MTAB-9388-20261026"
    },
    "tyser_design": {
      "source": "tyser_embryonic_design",
      "version": "E-MTAB-9388-20261026"
    },
    "host_cell_rna": {
      "source": "hpa_single_cell_tissue",
      "version": "v23"
    },
    "host_protein": {
      "source": "hpa_normal_tissue",
      "version": "v23"
    }
  },
  "reference_panels": {
    "gtex_individual_samples": {
      "source": "gtex_individual_tissue_tpm",
      "release": "v11",
      "tissues": "adult primary tissues",
      "unit": "TPM",
      "normal_source_id": "gtex_donor_p95:v11",
      "normal_statistic": "Linear donor P95 within each non-reproductive site",
      "reproductive_statistic": "Individual sample TPM"
    }
  },
  "steps": {
    "rare_cell": {
      "needs": [],
      "argv": [
        "scripts/build_rare_cell_evidence.py",
        "--regrade-pinned"
      ]
    },
    "catalog": {
      "needs": [
        "rare_cell",
        "tissue_gates"
      ],
      "argv": [
        "scripts/rebuild_target_catalog.py"
      ]
    },
    "plots": {
      "needs": [
        "host_exposure",
        "normal_library_qc"
      ],
      "argv": [
        "scripts/render_target_catalog.py"
      ]
    },
    "report": {
      "needs": [
        "plots"
      ],
      "argv": [
        "scripts/build_target_selection_report.py"
      ]
    },
    "filter_audit": {
      "needs": [
        "report"
      ],
      "argv": [
        "scripts/build_target_filter_audit.py"
      ]
    },
    "filter_web_report": {
      "needs": [
        "filter_audit"
      ],
      "argv": [
        "scripts/build_target_filter_web_report.py"
      ]
    },
    "host_exposure": {
      "needs": [
        "catalog"
      ],
      "argv": [
        "scripts/build_host_exposure.py"
      ]
    },
    "literature_audit": {
      "needs": [
        "catalog"
      ],
      "argv": [
        "scripts/audit_antigen_paper_counts.py"
      ]
    },
    "reproductive_ihc_audit": {
      "needs": [
        "catalog"
      ],
      "argv": [
        "scripts/audit_reproductive_ihc_route.py"
      ]
    },
    "gtex_witness_audit": {
      "needs": [
        "catalog"
      ],
      "argv": [
        "scripts/audit_gtex_symmetric_witnesses.py"
      ]
    },
    "normal_library_qc": {
      "needs": [
        "catalog"
      ],
      "argv": [
        "scripts/audit_normal_library_qc.py"
      ]
    },
    "whitepaper": {
      "needs": [
        "filter_audit",
        "plots"
      ],
      "argv": [
        "scripts/render_antigen_whitepaper.py"
      ]
    },
    "tissue_gates": {
      "needs": [],
      "argv": [
        "scripts/rebuild_revised_tissue_gates.py"
      ]
    }
  },
  "output_roots": [
    "docs/audits/target-selection-20261110/rebuild",
    "docs/audits/target-filters-20261112",
    "docs/audits/antigen-evidence-review-20261117",
    "docs/audits/antigen-evidence-review-20261118",
    "docs/audits/gtex-reproductive-witnesses",
    "docs/antigen-whitepaper"
  ],
  "outputs": [
    "oncoref/data/target-selection.csv.gz",
    "oncoref/data/target-selection.json",
    "oncoref/data/rare-cell-evidence.csv.gz",
    "oncoref/data/rare-cell-evidence.json",
    "docs/audits/target-selection-20261110/definition.json",
    "docs/audits/target-selection-20261110/report.html",
    "docs/target-selection.md",
    "docs/target-filters.md",
    "oncoref/data/host-exposure.csv.gz",
    "oncoref/data/host-exposure.json",
    "docs/antigen-whitepaper.md",
    "docs/species-antigen-whitepaper.md",
    "docs/tissue-hierarchy.md"
  ]
}
